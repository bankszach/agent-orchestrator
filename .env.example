# Configure multiple MCP servers as JSON list
# name: label for selection; url: JSON-RPC endpoint root; api_key: optional
MCP_SERVERS=[
  {
    "name": "clock",
    "url": "https://mcp-test-service-596716165839.us-west2.run.app/",
    "api_key": ""
  },
  {
    "name": "future_server",
    "url": "https://example.com/mcp/",
    "api_key": ""
  }
]

# CORS override (comma-separated list)
ALLOW_ORIGINS=*
